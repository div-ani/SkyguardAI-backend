# Copy this file to .env and adjust as needed.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/skyguard_ai

# CORS: the URL your frontend runs on (e.g. http://127.0.0.1:5500 for Live Server)
CLIENT_ORIGIN=*

# When true, the server generates fake sensor readings itself so the API has
# data to serve without any real hardware. Turn this OFF in production and
# have real stations call POST /api/readings instead.
ENABLE_SIMULATOR=true
